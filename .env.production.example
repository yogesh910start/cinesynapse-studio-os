# ==============================================================================
# CINE-SYNAPSE STUDIO OS - Production Environment Configuration
# ==============================================================================

# Core Application Settings
APP_ENV=production
PROJECT_NAME="CineSynapse Studio OS"
API_V1_PREFIX=/api/v1
PORT=8080
HOST=0.0.0.0
DEBUG=false

# Security & CORS (Set to your production domain)
JWT_SECRET=replace-with-cryptographically-secure-random-token-min-64-chars
ALLOWED_ORIGINS=["https://cinesynapse.studio","https://studio.cine-synapse.com"]
RATE_LIMIT_ENABLED=true

# Google Cloud AI / Gemini 1.5 Pro (Hackathon Core Framework)
GEMINI_API_KEY=your-production-gemini-api-key
GEMINI_MODEL_ID=gemini-1.5-pro

# ClickHouse Cloud / MCP Cluster Configuration (Partner Track)
CLICKHOUSE_HOST=your-clickhouse-cloud-host.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-clickhouse-cloud-password
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=true
CLICKHOUSE_MOCK_FALLBACK=false

# Storage Provider Configuration ("gcs" for production, "local" for air-gapped stage)
STORAGE_PROVIDER=gcs
STORAGE_LOCAL_PATH=storage/local
GCS_BUCKET_VAULT=cine-synapse-vault-production

# Enterprise Production Mesh
SHOTGRID_API_URL=https://studio.shotgrid.autodesk.com/api/v1
SHOTGRID_SCRIPT_NAME=cinesynapse_production_daemon
SHOTGRID_API_KEY=your-production-shotgrid-key
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR/TEAMS/WEBHOOK
