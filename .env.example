# CINE-SYNAPSE Studio OS - Environment Configuration Template
APP_ENV=development
PROJECT_NAME="CINE-SYNAPSE Studio OS"
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0

# Security & CORS
JWT_SECRET=supersecret-dev-jwt-key-2026-replace-in-production
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
RATE_LIMIT_ENABLED=true

# ClickHouse Cloud Configuration
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=true
CLICKHOUSE_MOCK_FALLBACK=true

# Google Cloud AI / Gemini 1.5 Pro
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-1.5-pro

# File Storage Provider ("local" or "gcs")
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=storage/local
GCS_BUCKET_VAULT=cine-synapse-vault-prod

# Enterprise Mesh Integrations
SHOTGRID_API_URL=https://paramount.shotgrid.autodesk.com/api/v1
SHOTGRID_SCRIPT_NAME=cinesynapse_daemon
SHOTGRID_API_KEY=mock-shotgrid-key
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/mock/token
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/mock/token
